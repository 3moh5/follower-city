# Railway Variables — Instagram API with Unified Login
ADMIN_KEY=ضع_مفتاحاً_عشوائياً_طويلاً_وسرياً
DATA_FILE=/data/data.json
IG_APP_ID=Meta_App_ID_من_App_Settings_Basic
IG_APP_SECRET=Meta_App_Secret_من_App_Settings_Basic
IG_CONFIG_ID=Configuration_ID_من_API_setup_with_Unified_login
IG_REDIRECT_URI=https://YOUR-RAILWAY-DOMAIN/auth/instagram/callback
# اختياري عند تعذر اكتشاف أصل الحساب تلقائياً:
# IG_BUSINESS_ID=معرف_محفظة_الأعمال
# IG_USER_ID=معرف_حساب_انستغرام
GRAPH_VERSION=v25.0
POLL_SECONDS=120
MEDIA_LIMIT=12
VERIFY_TOKEN=قيمة_عشوائية_للويبهوك
